# Dhan API Configuration
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here
DHAN_TOTP_SECRET=your_totp_secret_here

# Nifty Futures Symbol (update monthly after expiry)
# Format: NSE:NIFTY{YY}{MON}FUT  e.g. NSE:NIFTY26MARFUT
FYERS_SYMBOL=NSE:NIFTY26MARFUT

# Dhan security ID for Nifty near-month future
# Find this from Dhan's instrument list or API
DHAN_SECURITY_ID=49081

# Exchange segment (NSE_FNO for futures)
DHAN_EXCHANGE_SEGMENT=NSE_FNO

# Refresh interval in milliseconds for DOM polling
REFRESH_INTERVAL_MS=500

# Wall detection threshold (multiplier of average quantity)
WALL_THRESHOLD=3.0

# Absorption detection - minimum ticks to track
ABSORPTION_TICKS=10

# Server port
PORT=8000
